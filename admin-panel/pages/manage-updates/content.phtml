<div class="container-fluid">
    <div class="block-header">
        <h2>Updates > Updates & Bug Fixes</h2>
    </div>
    <div class="row">
        <div class="col-lg-8 col-md-8">
            <div class="card">
                <div class="header">
                    <h2>Install Local Update</h2>
                </div>
                <div class="body">
                    <div class="alert alert-info">
                        Upload a WoWonder update zip (for example v4.3.4.zip) to merge it into this site. Create a backup first.
                    </div>
                    <div id="update-result"></div>
                    <form id="local-update-form" method="POST" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Update zip file</label>
                            <input type="file" name="update_zip" id="update_zip" accept=".zip" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-primary waves-effect" id="upload-update-btn">Upload &amp; Install Update</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
$('#local-update-form').on('submit', function (e) {
    e.preventDefault();
    var btn = $('#upload-update-btn');
    var fileInput = document.getElementById('update_zip');
    if (!fileInput.files.length) {
        alert('Please choose a zip file');
        return;
    }
    var data = new FormData();
    data.append('update_zip', fileInput.files[0]);
    btn.prop('disabled', true).text('Installing, please wait...');
    $.ajax({
        url: '<?php echo rtrim($wo['config']['site_url'], '/'); ?>/updater.php?f=run_updater',
        type: 'POST',
        data: data,
        processData: false,
        contentType: false,
        success: function (res) {
            if (res.status == 200) {
                $('#update-result').html('<div class="alert alert-success">Update installed. Refresh the page and clear browser cache.</div>');
            } else {
                $('#update-result').html('<div class="alert alert-danger">' + (res.ERROR_NAME || 'Update failed') + '</div>');
            }
            btn.prop('disabled', false).text('Upload & Install Update');
        },
        error: function () {
            $('#update-result').html('<div class="alert alert-danger">Upload failed. Please try again.</div>');
            btn.prop('disabled', false).text('Upload & Install Update');
        }
    });
});
</script>
